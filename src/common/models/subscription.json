{
  "name": "subscription",
  "base": "PersistedModel",
  "idInjection": true,
  
  "options": {
    "validateUpsert": true,
    "mongodb": {
      "collection": "subscription",
      "allowExtendedOperators": true
    }
  },
  "mixins": {
    "TimeStamp": {
      "required": true,
      "validateUpsert": true,
      "silenceWarnings": true
    }
  },
  "properties": {
    "customerId": {
      "type": "string",
      "required": true
    },
    "planId": {
      "type": "string",
      "required": true
    },
    "subscriptionId": {
      "type": "string",
      "required": true
    },
    "trialStart": {
      "type": "date"
    },
    "trialEnd": {
      "type": "date"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "required": true
    },
    "frequency": {
      "type": "string",
      "required": true
    },
    "nextSubscriptionDate": {
      "type": "date",
      "required": true
    },
    "subscriptionDetails": {
      "type": "object",
      "required": true
    }
  },
  "validations": [],
  "relations": {
    "user": {
      "type": "belongsTo",
      "model": "user",
      "foreignKey": "userId",
      "options": {
        "nestRemoting": true
      }
    },
    "company": {
      "type": "belongsTo",
      "model": "company",
      "foreignKey": "companyId",
      "options": {
        "nestRemoting": true
      }
    }
  },
  "acls": [],
  "methods": {
    "getPlans": {
      "accepts": [],
      "returns": {
        "arg": "plans",
        "type": "array"
      },
      "http": {
        "path": "/get-plans",
        "verb": "get"
      }
    },
    "getPlansFree": {
      "accepts": [],
      "returns": {
        "arg": "plans",
        "type": "array"
      },
      "http": {
        "path": "/get-plans-free",
        "verb": "get"
      }
    },
    "assignPlan": {
      "accepts": [
        {
          "arg": "planId",
          "type": "string",
          "required": true
        },
        {
          "arg": "couponCode",
          "type": "string",
          "required": false
        }
      ],
      "returns": {
        "arg": "message",
        "type": "string"
      },
      "http": {
        "path": "/assign-plan",
        "verb": "post"
      }
    },
    "getSubscribedUsers": {
      "accepts": [
        {
          "arg": "companyId",
          "type": "string",
          "required": true
        },
        {
          "arg": "userType",
          "type": "string"
        }
      ],
      "returns": {
        "arg": "users",
        "type": "object"
      },
      "http": {
        "path": "/get-subscribed-users",
        "verb": "post"
      }
    },
    "cancel": {
      "accepts": [
        {
          "arg": "userId",
          "type": "string",
          "required": true
        }
      ],
      "returns": {
        "arg": "users",
        "type": "object"
      },
      "http": {
        "path": "/cancel",
        "verb": "post"
      }
    },
    "getUserCount": {
      "accepts": [],
      "returns": {
        "arg": "count",
        "type": "object"
      },
      "http": {
        "path": "/get-user-count",
        "verb": "get"
      }
    },
    "getPortal": {
      "accepts": [
        {
          "arg": "res",
          "type": "object",
          "http": {
            "source": "res"
          }
        }
      ],
      "returns": {
        "arg": "result",
        "type": "any"
      },
      "http": {
        "path": "/get-portal",
        "verb": "get"
      }
    },
    "verifyCoupon": {
      "accepts": [
        {
          "arg": "couponCode",
          "type": "string",
          "required": true,
          "description": "Coupon/discount code to verify"
        }
      ],
      "returns": {
        "arg": "result",
        "type": "object"
      },
      "http": {
        "path": "/verify-coupon",
        "verb": "post"
      },
      "description": "Verify if a coupon code is valid"
    },
    "applyDiscount": {
      "accepts": [
        {
          "arg": "discountCode",
          "type": "string",
          "required": true,
          "description": "Discount code to apply to subscription"
        }
      ],
      "returns": {
        "arg": "result",
        "type": "object"
      },
      "http": {
        "path": "/apply-discount",
        "verb": "post"
      },
      "description": "Apply a discount code to current user's subscription"
    }
  }
}
